---
/**
 * Small pill label. `default` sits on light surfaces, `on-dark` on ink,
 * `before`/`after` tag the Before/After states.
 */
interface Props {
  variant?: "default" | "tint" | "on-dark" | "before" | "after";
  as?: "span" | "li";
  class?: string;
}

const { variant = "default", as: Tag = "span", class: className } = Astro.props;
---

<Tag class:list={["chip", `chip--${variant}`, className]}><slot /></Tag>

<style>
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 30px;
    padding: 5px 12px;
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--text-chip);
    font-weight: 500;
    line-height: 1.3;
    white-space: nowrap;
  }

  .chip--default {
    background: var(--surface);
    border-color: var(--border);
    color: var(--slate);
  }

  .chip--tint {
    background: var(--tint);
    color: var(--ink);
  }

  .chip--on-dark {
    background: var(--on-dark-chip);
    color: var(--surface);
  }

  .chip--before {
    background: var(--danger-tint);
    color: var(--danger);
    font-weight: 600;
  }

  .chip--after {
    background: var(--accent);
    color: var(--surface);
    font-weight: 600;
  }
</style>
