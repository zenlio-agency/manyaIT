---
/** 34px teal rounded square with a white rising-line glyph. Decorative. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 34, class: className } = Astro.props;
---

<svg
  class:list={["logo-mark", className]}
  width={size}
  height={size}
  viewBox="0 0 34 34"
  aria-hidden="true"
  focusable="false"
>
  <rect class="logo-mark__bg" width="34" height="34" rx="10"></rect>
  <path
    d="M8.5 23.5 14 17.5l4 3.5 7.5-9"
    fill="none"
    stroke="#fff"
    stroke-width="2.6"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
  <circle cx="25.5" cy="12" r="2.2" fill="#fff"></circle>
</svg>

<style>
  .logo-mark {
    flex: none;
  }

  .logo-mark__bg {
    fill: var(--accent);
  }
</style>
