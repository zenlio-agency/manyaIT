---
import TableScroll from "./TableScroll.astro";
import Chip from "./Chip.astro";

/**
 * Two-way comparison, e.g. "Typical IT vendor vs Siri". The last column is
 * Siri's and is highlighted.
 */
interface Props {
  caption: string;
  /** Column headings: row label, the other option, Siri. */
  columns: [string, string, string];
  rows: [string, string, string][];
  /** Show the caption above the table instead of only to screen readers. */
  showCaption?: boolean;
  class?: string;
}

const { caption, columns, rows, showCaption = false, class: className } = Astro.props;
---

<TableScroll label={caption} class:list={["compare", className]}>
  <table>
    <caption class:list={[!showCaption && "sr-only"]}>{caption}</caption>
    <thead>
      <tr>
        {columns[0] ? <th scope="col">{columns[0]}</th> : <td />}
        <th scope="col">{columns[1]}</th>
        <th scope="col" class="compare__ours"><Chip variant="after">{columns[2]}</Chip></th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map(([label, theirs, ours]) => (
          <tr>
            <th scope="row">{label}</th>
            <td class="compare__theirs">{theirs}</td>
            <td class="compare__ours">{ours}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</TableScroll>

<style>
  .compare :global(th:first-child) {
    width: 22%;
  }

  .compare__theirs {
    color: var(--muted);
  }

  td.compare__ours {
    background: var(--tint);
    color: var(--ink);
    font-weight: 500;
  }

  th.compare__ours {
    background: var(--tint);
  }

  thead th.compare__ours :global(.chip) {
    text-transform: none;
    letter-spacing: normal;
  }
</style>
