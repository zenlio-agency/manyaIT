---
/**
 * Bento grid: auto-fit columns of at least 280px, a row height per instance,
 * and tiles that can span two columns or rows (see Tile). Under 640px it is
 * one column and spans are removed.
 */
interface Props {
  /** Row height. Rows grow if a tile's content needs more room. */
  rowHeight?: string;
  /** Narrowest a column may get before the grid drops a column. */
  minColumn?: string;
  as?: "div" | "ul" | "ol";
  class?: string;
  "aria-label"?: string;
}

const {
  rowHeight = "240px",
  minColumn = "280px",
  as: Tag = "div",
  class: className,
  ...rest
} = Astro.props;
---

<Tag
  class:list={["bento", className]}
  style={`--bento-row: ${rowHeight}; --bento-min: ${minColumn};`}
  role={Tag === "div" ? undefined : "list"}
  {...rest}
>
  <slot />
</Tag>

<style>
  .bento {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(var(--bento-min), 100%), 1fr));
    grid-auto-rows: minmax(var(--bento-row), auto);
    grid-auto-flow: dense;
    gap: var(--tile-gap);
    padding: 0;
    list-style: none;
  }

  @media (max-width: 640px) {
    .bento {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: minmax(min(var(--bento-row), 240px), auto);
    }
  }
</style>
