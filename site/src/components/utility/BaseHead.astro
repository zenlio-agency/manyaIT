---
import { Font } from "astro:assets";
import { SITE_NAME } from "@/consts.ts";
import { settings } from "@/sanity/content.ts";
import { isNoindexRoute } from "@/utils/seo.ts";
import type { SeoProps } from "@/types.ts";

type Props = SeoProps;

/* Pages that set no description or social image use the defaults in
   Sanity's Site settings. */
const defaults = await settings();

const {
  title,
  description = defaults.description,
  image = defaults.socialImage ?? "/og-image.jpg",
  type = "website",
  noindex,
} = Astro.props;

const isNoindex = noindex ?? isNoindexRoute(Astro.url.pathname);

const isHome = Astro.url.pathname.replace(/\/+$/, "") === "";
/* A title that already names the company is used as written. */
const pageTitle = !title
  ? SITE_NAME
  : title.includes(SITE_NAME)
    ? title
    : isHome
      ? `${SITE_NAME} | ${title}`
      : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(image, Astro.site);
---

<meta charset="utf-8" />
<style is:inline>
  @layer base, patterns, components, utilities;
</style>
<meta name="viewport" content="width=device-width, initial-scale=1" />
<Font cssVariable="--font-inter" preload />
<Font cssVariable="--font-poppins" preload />
<Font cssVariable="--font-plus-jakarta" preload />
<meta name="theme-color" content="#FAFAFA" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{isNoindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={type} />
<meta property="og:site_name" content={SITE_NAME} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{defaults.faviconRasterUrl ? (
  <link rel="icon" href={defaults.faviconRasterUrl} sizes="32x32" />
) : (
  <link rel="icon" href="/favicon.ico" sizes="32x32" />
)}
{defaults.faviconSvgUrl ? (
  <link rel="icon" type="image/svg+xml" href={defaults.faviconSvgUrl} />
) : (
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
)}
{defaults.appleTouchIconUrl ? (
  <link rel="apple-touch-icon" href={defaults.appleTouchIconUrl} />
) : (
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
)}
<meta name="generator" content={Astro.generator} />
