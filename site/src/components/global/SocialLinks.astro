---
import Icon from "@/components/media/Icon.astro";
import linkedin from "@/assets/icons/social-linkedin.svg";
import x from "@/assets/icons/social-x.svg";
import facebook from "@/assets/icons/social-facebook.svg";
import youtube from "@/assets/icons/social-youtube.svg";
import instagram from "@/assets/icons/social-instagram.svg";
import { settings } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Extra classes on the list. */
  class?: string;
}

const { render = true, class: className } = Astro.props;
const icons = { linkedin, x, facebook, youtube, instagram };
const { social: SOCIAL } = await settings();
---

{
  render && SOCIAL.length > 0 && (
    <ul class:list={["social_list", className]}>
      {SOCIAL.map((item) => {
        /* Profiles still to be confirmed link to `#` and stay in this tab. */
        const live = item.href !== "#";
        return (
          <li>
            <a
              class="social_link"
              href={item.href}
              aria-label={
                live ? `${item.label} (opens in a new tab)` : item.label
              }
              target={live ? "_blank" : undefined}
              rel={live ? "noopener" : undefined}
            >
              <Icon src={icons[item.icon]} variant="small" />
            </a>
          </li>
        );
      })}
    </ul>
  )
}

<style is:global>
  @layer components {
    .social_list {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-1);
    }

    .social_link {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      color: var(--text-body);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--text);
          border-color: var(--text);
          color: var(--background);
        }
      }
    }
  }
</style>
