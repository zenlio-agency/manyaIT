---
import Logo from "@/components/global/Logo.astro";
import SocialLinks from "@/components/global/SocialLinks.astro";
import { capabilityHref, industryHref } from "@/data/site.ts";
import { capabilities, hubs, industries, settings } from "@/sanity/content.ts";
import { LEGAL_LINKS } from "@/data/legal.ts";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const [CAPABILITIES, INDUSTRIES, HUBS, { footerLine }] = await Promise.all([
  capabilities(),
  industries(),
  hubs(),
  settings(),
]);

const company = [
  { label: "About", href: "/about" },
  { label: "Careers", href: "/careers" },
  { label: "Insights", href: "/insights" },
  { label: "Contact", href: "/contact" },
];
---

{
  render && (
    <footer class="footer_wrap theme-dark">
      <div class="footer_inner">
        <div class="footer_top">
          <div class="footer_brand">
            <a class="footer_logo" href="/" aria-label={SITE_NAME}>
              <Logo />
            </a>
            <p class="footer_line">{footerLine}</p>
          </div>

          <nav class="footer_cols" aria-label="Footer">
            <div class="footer_col">
              <p class="footer_col_title">Capabilities</p>
              <ul>
                {CAPABILITIES.map((cap) => (
                  <li>
                    <a class="footer_link" href={capabilityHref(cap)}>
                      {cap.title}
                    </a>
                  </li>
                ))}
                <li>
                  <a class="footer_link" href="/capabilities/specialist-talent">
                    Specialist Talent
                  </a>
                </li>
              </ul>
            </div>
            <div class="footer_col">
              <p class="footer_col_title">Industries</p>
              <ul>
                {INDUSTRIES.map((industry) => (
                  <li>
                    <a class="footer_link" href={industryHref(industry)}>
                      {industry.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="footer_col">
              <p class="footer_col_title">Company</p>
              <ul>
                {company.map((link) => (
                  <li>
                    <a class="footer_link" href={link.href}>
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
            <div class="footer_col">
              <p class="footer_col_title">Locations</p>
              <ul class="footer_hubs">
                {HUBS.map((hub) => (
                  <li>
                    <a class="footer_link" href="/about#locations">
                      {hub.city}
                    </a>
                    <span class="footer_hub_role">{hub.role}</span>
                    <address class="footer_hub_address">{hub.address}</address>
                    <a
                      class="footer_link footer_hub_contact"
                      href={`tel:${hub.phone.replace(/[^+\d]/g, "")}`}
                    >
                      {hub.phone}
                    </a>
                    <a
                      class="footer_link footer_hub_contact"
                      href={`mailto:${hub.email}`}
                    >
                      {hub.email}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </nav>
        </div>

        <div class="footer_bottom">
          <p class="footer_copyright text-style-small">
            &copy; <span data-year>{new Date().getFullYear()}</span> {SITE_NAME}{" "}
            Inc. All rights reserved.
          </p>
          <ul class="footer_legal">
            {LEGAL_LINKS.map((link) => (
              <li>
                <a class="footer_link" href={link.href}>
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
          <SocialLinks />
        </div>
      </div>
    </footer>
  )
}

<script>
  const year = document.querySelector<HTMLSpanElement>("[data-year]");
  if (year) year.textContent = new Date().getFullYear().toString();
</script>

<style is:global>
  @layer components {
    .footer_wrap {
      display: flex;
      justify-content: center;
      padding-top: var(--space-8);
      padding-bottom: var(--space-5);
      padding-inline: var(--site-margin);
      background-color: var(--background);
      color: var(--text);
      border-top: var(--border-width) solid var(--divider);
    }

    .footer_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .footer_top {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
        gap: var(--space-8);
      }
    }

    .footer_brand {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
    }

    .footer_logo {
      font-size: 0.95rem;
    }

    .footer_line {
      max-width: 34ch;
      font-size: var(--text-small);
      color: var(--text-body);
    }

    .footer_cols {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5);
      @media (width >= 48rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .footer_col {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
      & ul {
        display: flex;
        flex-direction: column;
        gap: var(--space-1);
      }
    }

    .footer_col_title {
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--text-2);
    }

    .footer_link {
      font-size: var(--text-small);
      color: var(--text-body);
      transition: color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          color: var(--text);
        }
      }
    }

    .footer_hubs {
      gap: var(--space-3) !important;
      & li {
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
      }
    }

    .footer_hub_role {
      font-size: 0.8rem;
      color: var(--text-2);
    }

    /* The only place on the site that gives each office's city, address
       and direct contacts. */
    .footer_hub_address {
      margin-block: 0.3rem;
      font-size: 0.8rem;
      font-style: normal;
      line-height: 1.5;
      white-space: pre-line;
      color: var(--text-2);
    }

    .footer_hub_contact {
      font-size: 0.8rem;
    }

    .footer_bottom {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-6);
      padding-top: var(--space-4);
      border-top: var(--border-width) solid var(--divider);
    }

    .footer_copyright {
      color: var(--text-2);
    }

    /* Sized here rather than with a text-style class, whose leading-trim
       pseudo-elements would become flex items and indent the first link. */
    .footer_legal {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2) var(--space-5);
      font-size: var(--text-small);
    }
  }
</style>
