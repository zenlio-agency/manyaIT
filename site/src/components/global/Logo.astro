---
interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Show the mark alone, without the wordmark. */
  markOnly?: boolean;
  class?: string;
}

const { render = true, markOnly = false, class: className } = Astro.props;
---

{
  render && (
    <span class:list={["logo_wrap", className]}>
      {markOnly ? (
        <>
          <img
            src="/images/logo-mark.png"
            alt=""
            class="logo_mark logo_light"
            width="34"
            height="22"
            loading="eager"
            decoding="async"
          />
          <img
            src="/images/logo-mark-dark.png"
            alt=""
            class="logo_mark logo_dark"
            width="34"
            height="22"
            loading="eager"
            decoding="async"
          />
        </>
      ) : (
        <>
          <img
            src="/images/logo-brand.png"
            alt="Manya IT"
            class="logo_img logo_light"
            width="153"
            height="24"
            loading="eager"
            decoding="async"
          />
          <img
            src="/images/logo-brand-dark.png"
            alt="Manya IT"
            class="logo_img logo_dark"
            width="153"
            height="24"
            loading="eager"
            decoding="async"
          />
        </>
      )}
    </span>
  )
}

<style is:global>
  @layer components {
    .logo_wrap {
      display: inline-flex;
      align-items: center;
      line-height: 1;

      & .logo_img {
        height: 24px !important;
        width: auto !important;
        object-fit: contain;
      }

      & .logo_mark {
        height: 22px !important;
        width: auto !important;
        object-fit: contain;
      }

      & .logo_light {
        display: block;
      }

      & .logo_dark {
        display: none;
      }
    }

    .theme-dark .logo_wrap {
      & .logo_light {
        display: none;
      }

      & .logo_dark {
        display: block;
      }
    }

    @media (hover: hover) {
      a:hover > .logo_wrap {
        opacity: 0.85;
      }
    }
  }
</style>
