---
import Icon from "@/components/media/Icon.astro";
import Button from "@/components/Button.astro";
import Logo from "@/components/global/Logo.astro";
import chevron from "@/assets/icons/ui-chevron.svg";
import arrow from "@/assets/icons/ui-arrow.svg";
import linkedin from "@/assets/icons/social-linkedin.svg";
import x from "@/assets/icons/social-x.svg";
import facebook from "@/assets/icons/social-facebook.svg";
import youtube from "@/assets/icons/social-youtube.svg";
import instagram from "@/assets/icons/social-instagram.svg";
import { NAV, capabilityHref, industryHref } from "@/data/site.ts";
import { capabilities, industries, settings } from "@/sanity/content.ts";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

const icons = { linkedin, x, facebook, youtube, instagram };

const [CAPABILITIES, INDUSTRIES, { cta: CTA, social: SOCIAL }] =
  await Promise.all([capabilities(), industries(), settings()]);

type MenuLink = { label: string; href: string };
type Menu = {
  /* A column without an eyebrow lines its links up with the one before. */
  columns: { eyebrow?: string; links: MenuLink[] }[];
  footerLinks?: MenuLink[];
  /* The column the footer links sit under; the last one by default. */
  footerColumn?: number;
  showSocials?: boolean;
  feature: { label: string; title: string; text: string; href: string };
};

const capLinks = (ids: string[]) =>
  CAPABILITIES.filter((cap) => ids.includes(cap.id)).map((cap) => ({
    label: cap.title,
    href: capabilityHref(cap),
  }));

const industryLinks = (ids: string[]) =>
  INDUSTRIES.filter((industry) => ids.includes(industry.id)).map(
    (industry) => ({ label: industry.title, href: industryHref(industry) }),
  );

/* Each panel opens inside the bar: link columns, optional small footer
   links under one of them, and a feature card on the right. */
const MENUS: Record<string, Menu> = {
  capabilities: {
    columns: [
      {
        eyebrow: "Data & AI",
        links: capLinks(["cap-data", "cap-ai", "cap-flow"]),
      },
      {
        eyebrow: "Platforms & Engineering",
        links: [
          ...capLinks(["cap-sap", "cap-code"]),
          { label: "Specialist Talent", href: "/capabilities/specialist-talent" },
        ],
      },
    ],
    footerLinks: [{ label: "All capabilities", href: "/capabilities" }],
    footerColumn: 0,
    showSocials: true,
    feature: {
      label: "Get started",
      title: "From objective to production",
      text: "Tell us the outcome you're targeting, and we'll map the route from strategy to a running platform.",
      href: CTA.primary.href,
    },
  },
  industries: {
    columns: [
      {
        eyebrow: "Industries",
        links: industryLinks([
          "industry-banking",
          "industry-telecom",
          "industry-healthcare",
        ]),
      },
      { links: industryLinks(["industry-energy", "industry-retail"]) },
    ],
    footerLinks: [
      { label: "All industries", href: "/industries" },
      { label: "Talk to us about your sector", href: CTA.primary.href },
    ],
    footerColumn: 0,
    feature: {
      label: "Industries",
      title: "Built for your sector",
      text: "Technology, data and AI programs shaped by your industry's regulation, core systems and operating pressures.",
      href: "/industries",
    },
  },
};
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]} data-nav>
      <div class="nav_card">
        <div class="nav_bar">
          <a class="nav_logo" href="/" aria-label={SITE_NAME}>
            <Logo />
          </a>

          <nav class="nav_main" aria-label="Main">
            <ul class="nav_links">
              {NAV.map((item) => (
                <li>
                  {"menu" in item ? (
                    <button
                      class="nav_link"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`menu-${item.menu}`}
                      data-menu-trigger={item.menu}
                    >
                      {item.label}
                      <Icon src={chevron} variant="small" class="nav_chevron" />
                    </button>
                  ) : (
                    <a
                      class="nav_link"
                      href={item.href}
                      aria-current={path === item.href ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>

          <div class="nav_actions">
            <Button element="link" href={CTA.primary.href}>
              {CTA.primary.label}
            </Button>
          </div>

          <button
            class="nav_toggle"
            type="button"
            aria-expanded="false"
            aria-controls="nav-mobile"
            aria-label="Open menu"
          >
            <span class="nav_toggle_icon" aria-hidden="true" />
          </button>
        </div>

        {/* Desktop panels, shared by every item with a menu */}
        <div class="nav_mega">
          <div class="nav_mega_inner">
            {Object.entries(MENUS).map(([key, menu]) => (
              <div class="nav_panel" id={`menu-${key}`} data-panel={key} hidden>
                <div
                  class="nav_panel_grid"
                  style={`--_columns: ${menu.columns.length}`}
                >
                  {menu.columns.map((column, index) => (
                    <div class="nav_column">
                      {column.eyebrow ? (
                        <span class="nav_eyebrow">{column.eyebrow}</span>
                      ) : (
                        <span class="nav_eyebrow is-blank" aria-hidden="true">
                          &nbsp;
                        </span>
                      )}
                      <ul class="nav_column_links">
                        {column.links.map((link) => (
                          <li>
                            <a class="nav_big_link" href={link.href}>
                              {link.label}
                              <Icon src={arrow} variant="small" />
                            </a>
                          </li>
                        ))}
                      </ul>
                      {index ===
                        (menu.footerColumn ?? menu.columns.length - 1) &&
                        menu.footerLinks && (
                          <ul class="nav_column_footer">
                            {menu.footerLinks.map((link) => (
                              <li>
                                <a href={link.href}>{link.label}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                    </div>
                  ))}
                  <a class="nav_feature theme-dark" href={menu.feature.href}>
                    <Logo markOnly class="nav_feature_logo" />
                    <span class="nav_feature_caption">
                      <span class="nav_feature_label">
                        {menu.feature.label}
                      </span>
                      <span class="nav_feature_title">
                        {menu.feature.title}
                      </span>
                      <span class="nav_feature_text">{menu.feature.text}</span>
                    </span>
                    <Icon src={arrow} class="nav_feature_arrow" />
                  </a>
                </div>
                {menu.showSocials && (
                  <ul class="nav_socials">
                    {SOCIAL.map((item) => (
                      <li>
                        <a
                          href={item.href}
                          aria-label={
                            item.href === "#"
                              ? item.label
                              : `${item.label} (opens in a new tab)`
                          }
                          target={item.href === "#" ? undefined : "_blank"}
                          rel={item.href === "#" ? undefined : "noopener"}
                        >
                          <Icon src={icons[item.icon]} variant="small" />
                        </a>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            ))}
          </div>
        </div>

        {/* Mobile panel */}
        <div class="nav_mobile" id="nav-mobile">
          <div class="nav_mobile_inner">
            <ul class="nav_mobile_links">
              {NAV.map((item) =>
                "menu" in item ? (
                  <li>
                    <button
                      class="nav_mobile_link"
                      type="button"
                      aria-expanded="false"
                      aria-controls={`mobile-${item.menu}`}
                      data-sub-trigger
                    >
                      {item.label}
                      <Icon src={chevron} variant="small" class="nav_chevron" />
                    </button>
                    <ul
                      class="nav_mobile_sub"
                      id={`mobile-${item.menu}`}
                      hidden
                    >
                      {[
                        ...MENUS[item.menu].columns.flatMap(
                          (column) => column.links,
                        ),
                        ...(MENUS[item.menu].footerLinks ?? []),
                      ].map((link) => (
                        <li>
                          <a href={link.href}>{link.label}</a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li>
                    <a
                      class="nav_mobile_link"
                      href={item.href}
                      aria-current={path === item.href ? "page" : undefined}
                    >
                      {item.label}
                    </a>
                  </li>
                ),
              )}
            </ul>
            <div class="nav_mobile_actions">
              <Button element="link" href={CTA.primary.href}>
                {CTA.primary.label}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </header>
  )
}

{/* No-JS fallback: the mobile list shows open and panels open on hover. */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_mobile {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_mobile_sub[hidden],
    .nav_panel[hidden] {
      display: flex;
    }
    .nav_card:is(:hover, :focus-within) .nav_mega {
      grid-template-rows: 1fr;
      visibility: visible;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>("[data-nav]");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");
  const desktop = matchMedia("(width >= 64rem)");

  if (nav && toggle) {
    const root = document.documentElement;
    const triggers = [
      ...nav.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]"),
    ];
    const panels = [...nav.querySelectorAll<HTMLElement>("[data-panel]")];
    let current: string | null = null;

    /* The last panel stays rendered while the bar closes, so it folds away
       instead of vanishing. */
    const showMenu = (key: string | null) => {
      current = key;
      if (key) {
        panels.forEach((panel) => (panel.hidden = panel.dataset.panel !== key));
      }
      nav.classList.toggle("is-mega-open", key !== null);
      triggers.forEach((trigger) =>
        trigger.setAttribute(
          "aria-expanded",
          String(trigger.dataset.menuTrigger === key),
        ),
      );
    };

    const setMobile = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      root.classList.toggle("nav-locked", open && !desktop.matches);
    };

    let closeTimeout: ReturnType<typeof setTimeout> | null = null;

    const cancelClose = () => {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
    };

    const scheduleClose = (delay = 200) => {
      cancelClose();
      closeTimeout = setTimeout(() => {
        showMenu(null);
      }, delay);
    };

    const navCard = nav.querySelector<HTMLElement>(".nav_card");
    const navMega = nav.querySelector<HTMLElement>(".nav_mega");

    for (const trigger of triggers) {
      trigger.addEventListener("mouseenter", () => {
        if (!desktop.matches) return;
        cancelClose();
        const key = trigger.dataset.menuTrigger ?? null;
        if (key) showMenu(key);
      });

      trigger.addEventListener("focus", () => {
        if (!desktop.matches) return;
        cancelClose();
        const key = trigger.dataset.menuTrigger ?? null;
        if (key) showMenu(key);
      });

      trigger.addEventListener("click", () => {
        const key = trigger.dataset.menuTrigger ?? null;
        showMenu(current === key ? null : key);
      });
    }

    navMega?.addEventListener("mouseenter", () => {
      if (!desktop.matches) return;
      cancelClose();
    });

    navCard?.addEventListener("mouseleave", () => {
      if (!desktop.matches) return;
      if (current) {
        scheduleClose(200);
      }
    });

    nav
      .querySelectorAll<HTMLElement>(
        ".nav_main a.nav_link, .nav_logo, .nav_actions",
      )
      .forEach((el) => {
        el.addEventListener("mouseenter", () => {
          if (!desktop.matches) return;
          if (current) {
            scheduleClose(150);
          }
        });
      });

    navCard?.addEventListener("focusout", (event) => {
      if (!desktop.matches) return;
      if (
        current &&
        event.relatedTarget instanceof Node &&
        !navCard.contains(event.relatedTarget)
      ) {
        scheduleClose(100);
      }
    });

    toggle.addEventListener("click", () =>
      setMobile(toggle.getAttribute("aria-expanded") !== "true"),
    );

    for (const sub of nav.querySelectorAll<HTMLButtonElement>(
      "[data-sub-trigger]",
    )) {
      sub.addEventListener("click", () => {
        const list = document.getElementById(
          sub.getAttribute("aria-controls") ?? "",
        );
        if (!list) return;
        list.hidden = !list.hidden;
        sub.setAttribute("aria-expanded", String(!list.hidden));
      });
    }

    nav.querySelectorAll("a").forEach((link) =>
      link.addEventListener("click", () => {
        showMenu(null);
        setMobile(false);
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (current) {
        const trigger = triggers.find((t) => t.dataset.menuTrigger === current);
        showMenu(null);
        trigger?.focus();
      } else if (nav.classList.contains("open")) {
        setMobile(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Node) || nav.contains(target)) return;
      showMenu(null);
      setMobile(false);
    });

    desktop.addEventListener("change", () => {
      showMenu(null);
      setMobile(false);
    });

    /* A deeper shadow once the page moves under the bar. */
    const onScroll = () =>
      nav.classList.toggle("is-scrolled", window.scrollY > 8);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }
</script>

<style is:global>
  @layer components {
    /* The header keeps a fixed height in the flow; the card grows past it
       when a panel opens, so the page never shifts. */
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      height: var(--nav-height);
      display: flex;
      justify-content: center;
      align-items: flex-start;
      padding: 0.75rem var(--site-margin) 0;
      color: var(--text);
      pointer-events: none;
      view-transition-name: site-nav;

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav-locked {
      overflow: hidden;
    }

    .nav_card {
      width: 100%;
      max-width: var(--max-width-main);
      overflow: clip;
      pointer-events: auto;
      background-color: var(--background-2);
      border: var(--border-width) solid
        color-mix(in srgb, var(--border) 70%, transparent);
      border-radius: 1.5rem;
      box-shadow:
        0 1px 2px rgb(13 15 13 / 0.04),
        0 0.75rem 2rem -0.5rem rgb(13 15 13 / 0.1);
      transition: box-shadow var(--hover-duration) var(--hover-ease);
      .is-scrolled & {
        box-shadow:
          0 1px 2px rgb(13 15 13 / 0.05),
          0 1rem 2.5rem -0.75rem rgb(13 15 13 / 0.18);
      }
    }

    .nav_bar {
      min-height: 4rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-4);
      padding: 0.5rem 0.5rem 0.5rem var(--space-5);
      @media (width >= 64rem) {
        padding-right: 0.625rem;
      }
    }

    .nav_logo {
      display: flex;
      align-items: center;
      flex: none;
      font-size: 0.95rem;
    }

    /* Desktop links: soft pills */
    .nav_main,
    .nav_actions,
    .nav_mega {
      display: none;
    }

    .nav_links {
      display: flex;
      align-items: center;
      gap: 0.25rem;
    }

    .nav_link {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.5rem clamp(0.625rem, 1vw, 1rem);
      border-radius: var(--radius-round);
      font-family: var(--heading-family);
      font-size: 0.9375rem;
      font-weight: var(--heading-medium);
      color: var(--text-body);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-3);
          color: var(--text);
        }
      }
      &[aria-expanded="true"] {
        background-color: var(--background-3);
        color: var(--text);
      }
      &[aria-current="page"] {
        color: var(--accent-text);
      }
    }

    .nav_chevron {
      transition: rotate 300ms var(--reveal-ease);
      [aria-expanded="true"] > & {
        rotate: 180deg;
      }
    }

    .nav_actions {
      align-items: center;
      gap: 0.5rem;
      flex: none;
      & .button_wrap {
        border-radius: var(--radius-round);
        font-size: var(--text-small);
      }
      & .button_wrap.secondary {
        border-color: var(--border);
        background-color: var(--background);
      }
    }

    /* Mobile toggle: two bars that cross into an X */
    .nav_toggle {
      --_bar-gap: 0.4rem;
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      border-radius: var(--radius-round);
      color: var(--text);
      transition: background-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-3);
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: 1.25rem;
      height: calc(var(--_bar-gap) + var(--border-width) * 1.5);
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: calc(var(--border-width) * 1.5);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
      .nav_wrap.open & {
        &::before {
          transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
        }
        &::after {
          transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
        }
      }
    }

    /* Panels fold open inside the card */
    .nav_mega,
    .nav_mobile {
      grid-template-rows: 0fr;
      visibility: hidden;
      transition:
        grid-template-rows 350ms var(--reveal-ease),
        visibility 350ms var(--reveal-ease);
    }

    .nav_mega_inner,
    .nav_mobile_inner {
      min-height: 0;
      overflow: hidden;
      opacity: 0;
      transition: opacity 250ms var(--hover-ease);
    }

    .nav_wrap.is-mega-open .nav_mega,
    .nav_wrap.open .nav_mobile {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.is-mega-open .nav_mega_inner,
    .nav_wrap.open .nav_mobile_inner {
      opacity: 1;
    }

    .nav_panel {
      display: flex;
      flex-direction: column;
      &[hidden] {
        display: none;
      }
    }

    .nav_panel_grid {
      display: grid;
      /* One track per link column, then the feature card. */
      grid-template-columns: repeat(var(--_columns, 2), minmax(0, 1fr)) auto;
      gap: 2.5rem;
      padding: 0.5rem 2rem 2rem;
    }

    .nav_column {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .nav_eyebrow {
      width: fit-content;
      padding: 0.375rem 1rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
      color: var(--text-2);
      /* Keeps the eyebrow's height so the links line up. */
      &.is-blank {
        visibility: hidden;
      }
    }

    .nav_column_links {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .nav_big_link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      font-family: var(--heading-family);
      font-size: 1.25rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-snug);
      line-height: 1.25;
      color: var(--text);
      transition: color var(--hover-duration) var(--hover-ease);
      & .icon {
        opacity: 0;
        translate: -0.35rem 0;
        transition:
          opacity var(--hover-duration) var(--hover-ease),
          translate var(--hover-duration) var(--hover-ease);
      }
      @media (hover: hover) {
        &:hover {
          color: var(--accent);
          & .icon {
            opacity: 1;
            translate: 0 0;
          }
        }
      }
    }

    .nav_column_footer {
      margin-top: auto;
      padding-top: 3rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      font-size: 0.875rem;
      & a {
        color: var(--text-2);
        text-decoration: none;
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            color: var(--text);
          }
        }
      }
    }

    /* Feature card in the image slot: ink ground, blue glow, the mark */
    .nav_feature {
      position: relative;
      width: 18rem;
      min-height: 16rem;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: var(--space-5);
      padding: var(--space-5);
      border-radius: 1rem;
      overflow: clip;
      background-color: var(--background);
      background-image:
        radial-gradient(
          circle at 85% 10%,
          color-mix(in srgb, var(--blue-500) 55%, transparent),
          transparent 60%
        ),
        radial-gradient(
          circle at 0% 100%,
          color-mix(in srgb, var(--blue-700) 40%, transparent),
          transparent 55%
        );
      color: var(--text);
      @media (hover: hover) {
        &:hover {
          .nav_feature_arrow {
            translate: 0.25rem 0;
          }
        }
      }
    }

    /* The navbar mark in its dark-background colours, as in the footer. */
    .nav_feature_logo {
      font-size: 1.5rem;
    }

    .nav_feature_caption {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .nav_feature_label {
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--accent);
    }

    .nav_feature_title {
      font-family: var(--heading-family);
      font-size: var(--text-large);
      font-weight: var(--heading-bold);
      line-height: 1.25;
    }

    .nav_feature_text {
      font-size: var(--text-small);
      line-height: 1.5;
      color: var(--text-2);
    }

    .nav_feature_arrow {
      position: absolute;
      top: var(--space-5);
      right: var(--space-5);
      width: 1.1rem;
      transition: translate var(--hover-duration) var(--hover-ease);
    }

    .nav_socials {
      display: flex;
      gap: 1rem;
      padding: 0 2rem 2rem;
      & a {
        display: grid;
        place-items: center;
        color: var(--text-body);
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
