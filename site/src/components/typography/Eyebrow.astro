---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. */
  variant?: "default" | "tag";
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);

/* The pill labels over sections and page headings are switched off across
   the site at ManyaIT's request. Their words stay in the code and the
   Studio; set this to true to bring them back. */
const SHOW_EYEBROWS = false;
---

{
  SHOW_EYEBROWS && render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      {variant === "default" && (
        <span class="eyebrow_marker" aria-hidden="true" />
      )}
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Pill label: a Manya Blue dot and the section name. White on light
       sections, a faint glass pill on dark ones. */
    .eyebrow_wrap {
      --_dot: var(--blue-500);
      display: inline-flex;
      /* Hugs its text even inside stretching flex columns. */
      width: fit-content;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: 0.6rem;
      padding: 0.45rem 1rem 0.45rem 0.8rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      color: var(--text);
      .theme-dark & {
        --_dot: var(--blue-400);
      }

      .eyebrow_text {
        font-family: var(--primary-family);
        font-size: var(--text-small);
        font-weight: var(--primary-regular);
        line-height: 1.2;
      }

      &.tag {
        border-color: transparent;
        background-color: var(--accent-soft);
        color: var(--accent-text);
        padding: 0.4em 0.85em;
        .eyebrow_text {
          font-size: 0.75rem;
          letter-spacing: 0.04em;
        }
      }
      .eyebrow_marker {
        flex: none;
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 50%;
        background-color: var(--_dot);
      }
    }
  }
</style>
