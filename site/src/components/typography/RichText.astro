---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type RichTextStyle =
  | "inherit"
  | "display"
  | "h1"
  | "h2"
  | "h3"
  | "h4"
  | "h5"
  | "h6"
  | "large"
  | "main"
  | "small";

interface Props extends HTMLAttributes<"div"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Type style. */
  variant?: RichTextStyle;
  /**
   * Maximum line length in characters.
   *
   * @min 1
   * @int
   */
  maxWidth?: number;
}

const {
  render = true,
  variant = "inherit",
  maxWidth,
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={[
        "text",
        "rich-text",
        variant !== "inherit" && `text-style-${variant}`,
        className,
      ]}
      style={maxWidth ? `--_mw: ${maxWidth}ch;` : undefined}
      {...rest}
    >
      <Fragment set:html={content} />
    </div>
  )
}

<style is:global>
  @layer components {
    .rich-text {
      & :is(h1, h2, h3, h4, h5, h6, p, ul, ol, blockquote, figure, pre, table) {
        margin-top: var(--_margin-top);
        margin-bottom: var(--_margin-bottom);
      }

      & > :first-child,
      & :is(blockquote, li) > :first-child:not(:is(ul, ol)) {
        margin-top: 0;
      }
      & > :last-child,
      & :is(blockquote, li) > :last-child {
        margin-bottom: 0;
      }

      & :is(ul, ol) {
        padding-left: 1.5em;
      }
      & ul {
        list-style-type: disc;
      }
      & ul ul {
        list-style-type: circle;
      }
      & ul ul ul {
        list-style-type: square;
      }
      & ol {
        list-style-type: decimal;
      }
      & li::marker {
        color: color-mix(in lab, currentcolor 60%, transparent);
      }
      & li + li {
        margin-top: var(--space-2);
      }

      & li > :is(ul, ol) {
        margin-block: var(--space-2);
      }

      & blockquote {
        padding-left: var(--space-4);
        border-left: var(--border-width) solid var(--border);
      }
    }

    /* Tables scroll sideways inside their own box on narrow screens (see
       wrapTables in src/utils/html.ts). */
    .table-scroll {
      overflow-x: auto;
      margin-block: var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-small);
      & table {
        width: 100%;
        min-width: 40rem;
        margin: 0;
        border-collapse: collapse;
        font-size: var(--text-small);
        line-height: 1.5;
      }
      & th,
      & td {
        padding: 0.7rem 0.9rem;
        border-bottom: var(--border-width) solid var(--divider);
        text-align: left;
        vertical-align: top;
      }
      & th {
        background-color: var(--section-tint);
        font-family: var(--heading-family);
        font-weight: var(--heading-bold);
        color: var(--text);
      }
      & tr:last-child td {
        border-bottom: 0;
      }
    }
  }
</style>
