---
import SectionHeader from "@/components/content/SectionHeader.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { industryHref } from "@/data/site.ts";
import { home, industries } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const [INDUSTRIES, { sections }] = await Promise.all([industries(), home()]);
const intro = sections.industries;
---

{
  render && (
    <div class="industry-cards_wrap">
      <SectionHeader
        eyebrow={intro.eyebrow}
        heading={intro.heading}
        intro={intro.intro || undefined}
      >
        <Button
          slot="action"
          element="link"
          href="/industries"
          emphasis="secondary"
        >
          Explore Industries
        </Button>
      </SectionHeader>

      <ul class="industry-cards_list" style={`--_count: ${INDUSTRIES.length}`}>
        {INDUSTRIES.map((industry, index) => (
          <li
            class="industry-cards_item"
            id={industry.id}
            data-reveal
            style={`--reveal-order: ${index}`}
          >
            <PhotoTile
              href={industryHref(industry)}
              photo={industry.photo?.src}
              photoPosition={industry.photo?.position}
              class="industry-cards_tile"
            >
              <span class="photo-tile_eyebrow" slot="top">
                0{index + 1}
              </span>
              <h3 class="photo-tile_title is-small">{industry.title}</h3>
              <Fragment slot="reveal">
                <p class="photo-tile_text">{industry.line}</p>
                <span class="photo-tile_more">
                  Learn more
                  <Icon src={arrow} variant="small" />
                </span>
              </Fragment>
            </PhotoTile>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.industry-cards_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .industry-cards_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    /* Portrait photo tiles: two across, then all in one row from 80rem. */
    .industry-cards_list {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 30rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
      @media (width >= 80rem) {
        grid-template-columns: repeat(var(--_count), minmax(0, 1fr));
      }
    }

    .industry-cards_item {
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    .industry-cards_tile {
      aspect-ratio: 3 / 4;
      @media (30rem <= width < 80rem) {
        aspect-ratio: 4 / 3;
      }
    }

    /* Two across, an odd last tile spans the row instead of sitting alone. */
    .industry-cards_item:last-child:nth-child(odd) {
      @media (30rem <= width < 80rem) {
        grid-column: 1 / -1;
        & .industry-cards_tile {
          aspect-ratio: 8 / 3;
        }
      }
    }
  }
</style>
