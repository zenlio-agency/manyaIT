---
import SectionHeader from "@/components/content/SectionHeader.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import { insightHref } from "@/utils/insights.ts";
import { articles as allArticles, categories, home } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Paragraph under the heading. */
  intro?: string;
}

const [articles, topics, { sections }] = await Promise.all([
  allArticles(),
  categories(),
  home(),
]);
const header = sections.insights;

const { render = true, intro = header.intro } = Astro.props;

const filters = [{ title: "All", slug: "all" }, ...topics];
---

{
  render && (
    <div class="insights_wrap" data-insights>
      <SectionHeader
        eyebrow={header.eyebrow}
        heading={header.heading}
        intro={intro}
      >
        <div
          slot="action"
          class="insights_filters"
          role="group"
          aria-label="Filter insights"
        >
          {filters.map((filter, index) => (
            <button
              class="insights_filter"
              type="button"
              aria-pressed={index === 0 ? "true" : "false"}
              data-filter={filter.slug}
            >
              {filter.title}
            </button>
          ))}
        </div>
      </SectionHeader>

      <div class="insights_grid">
        {articles.map((article, index) => (
          <article
            class:list={["insights_item", article.featured && "is-featured"]}
            data-category={article.categorySlug}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <PhotoTile
              href={insightHref(article)}
              photo={article.photo.src}
              photoPosition={article.photo.position}
              photoWidth={article.photo.width}
              photoHeight={article.photo.height}
              class="insights_tile"
            >
              {/* Small tiles keep just the category so the line never wraps. */}
              <span class="photo-tile_eyebrow insights_meta" slot="top">
                <span>{article.category}</span>
                {article.featured && (
                  <Fragment>
                    <span>{article.type}</span>
                    <span>{article.minutes} min read</span>
                  </Fragment>
                )}
              </span>
              <h3
                class:list={[
                  "photo-tile_title",
                  article.featured ? "is-large" : "is-small",
                ]}
              >
                {article.title}
              </h3>
              <Fragment slot="reveal">
                <p class="photo-tile_text">{article.summary}</p>
                <span class="insights_more">Read article →</span>
              </Fragment>
            </PhotoTile>
          </article>
        ))}
      </div>
    </div>
  )
}

<script>
  for (const block of document.querySelectorAll<HTMLElement>(
    "[data-insights]",
  )) {
    const buttons = [
      ...block.querySelectorAll<HTMLButtonElement>("[data-filter]"),
    ];
    const cards = [...block.querySelectorAll<HTMLElement>("[data-category]")];
    for (const button of buttons) {
      button.addEventListener("click", () => {
        const filter = button.dataset.filter;
        buttons.forEach((b) =>
          b.setAttribute("aria-pressed", String(b === button)),
        );
        for (const card of cards) {
          const show = filter === "all" || card.dataset.category === filter;
          card.classList.toggle("is-filtered", !show);
          card.hidden = !show;
        }
        block.classList.toggle("is-filtering", filter !== "all");
      });
    }
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.insights_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .insights_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    /* Under the intro, starting where it starts. */
    .insights_filters {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
    }

    .insights_filter {
      padding: 0.5rem 1rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-round);
      background-color: var(--background-2);
      font-family: var(--heading-family);
      font-size: 0.8rem;
      font-weight: var(--heading-medium);
      color: var(--text-body);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          border-color: var(--text);
          color: var(--text);
        }
      }
      &[aria-pressed="true"] {
        background-color: var(--text);
        border-color: var(--text);
        color: var(--background);
      }
    }

    /* Photo tiles; the featured story takes a 2 × 2 block on desktop. */
    .insights_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 17rem;
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 16rem;
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        .insights_wrap:not(.is-filtering) & .is-featured {
          grid-column: span 2;
          grid-row: span 2;
        }
      }
    }

    .insights_item[hidden] {
      display: none;
    }

    .insights_tile {
      height: 100%;
      min-height: 0;
    }

    .insights_meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.25rem 0.75rem;
      & > span + span::before {
        content: "·";
        margin-right: 0.75rem;
        color: rgb(255 255 255 / 0.5);
      }
    }

    .insights_more {
      margin-top: var(--space-1);
      padding: 0.25rem 0.65rem;
      border-radius: var(--radius-round);
      background-color: rgb(255 255 255 / 0.14);
      font-size: 0.75rem;
      font-weight: var(--primary-medium);
    }
  }
</style>
