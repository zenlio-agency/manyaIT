---
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Button from "@/components/Button.astro";
import ButtonWrapper from "@/components/wrapper/ButtonWrapper.astro";
import Icon from "@/components/media/Icon.astro";
import CapabilityReel from "@/components/content/CapabilityReel.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { home, settings } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const [{ hero }, { cta: CTA }] = await Promise.all([home(), settings()]);
---

{
  render && (
    <div class="hero-home_wrap">
      <div class="hero-home_copy">
        <Heading
          tag="h1"
          variant="display"
          class="hero-home_title"
          data-reveal
          style="--reveal-order: 1"
        >
          {/* The space sits in the text: Astro drops one between tags. */}
          {`${hero.heading} `}
          <span class="hero-home_mark">{hero.highlight}</span>
        </Heading>
        <Paragraph
          maxWidth={60}
          class="hero-home_lede"
          data-reveal
          style="--reveal-order: 2"
        >
          {hero.lede}
        </Paragraph>
        <ul
          class="hero-home_points text-style-small"
          data-reveal
          style="--reveal-order: 3"
        >
          {hero.points.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
        <ButtonWrapper marginTop="5" data-reveal style="--reveal-order: 4">
          <Button element="link" href={CTA.primary.href}>
            {CTA.primary.label}
            <Icon src={arrow} variant="small" class="button_icon" />
          </Button>
          <Button element="link" href="/capabilities" emphasis="secondary">
            Explore Capabilities
          </Button>
        </ButtonWrapper>
      </div>
      <CapabilityReel class="hero-home_reel" />
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here is set per element, so type margins step aside. */
    :where(.hero-home_copy) :where(.heading, .text) {
      margin-block: 0;
    }

    .section:has(> .container > .hero-home_wrap) {
      background-image:
        radial-gradient(
          60rem 28rem at 50% -8rem,
          var(--blue-50),
          transparent 70%
        ),
        linear-gradient(to bottom, transparent 70%, var(--off-white));
    }

    .hero-home_wrap {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: var(--space-7);
      width: 100%;
      padding-top: var(--space-8);
    }

    /* Tall enough to centre the copy, short enough that the top quarter of
       the reel's cards always shows above the fold. */
    .hero-home_copy {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      --_alignment: center;
      max-width: 60rem;
      min-height: calc(
        100svh - var(--nav-height) - var(--space-8) - var(--space-7) -
          var(--space-2) - 13.5rem / 4
      );
    }

    /* Larger type, with tighter leading to hand back the extra height. */
    .hero-home_title {
      max-width: 26ch;
      font-family: var(--display-family);
      font-size: clamp(2.25rem, 1.5rem + 3.3vw, 4.25rem);
      font-weight: 700;
      letter-spacing: -0.035em;
      line-height: 1.02;
    }

    /* The palette's highlight: a soft blue band that draws in under the
       phrase once the headline arrives. */
    .hero-home_mark {
      background-image: linear-gradient(var(--accent-soft), var(--accent-soft));
      background-repeat: no-repeat;
      background-position: 0 84%;
      background-size: 100% 0.26em;
      padding-inline: 0.04em;
      box-decoration-break: clone;
      -webkit-box-decoration-break: clone;
      color: var(--accent-text);
    }

    .reveal-ready .hero-home_title .hero-home_mark {
      background-size: 0% 0.26em;
      transition: background-size 1.1s var(--reveal-ease) 0.55s;
    }

    .reveal-ready .hero-home_title.is-revealed .hero-home_mark {
      background-size: 100% 0.26em;
    }

    .hero-home_lede {
      margin-top: var(--space-5);
    }

    .hero-home_points {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: var(--space-1) var(--space-5);
      margin-top: var(--space-4);
      color: var(--text-2);
      & li {
        display: inline-flex;
        align-items: center;
        gap: 0.5em;
        &::before {
          content: "";
          width: 0.35rem;
          height: 0.35rem;
          border-radius: 50%;
          background-color: var(--accent);
        }
      }
    }

    /* The reel sits at the fold, below the reveal threshold, so it fades in
       on load rather than waiting to be scrolled to. */
    .reveal-ready .hero-home_reel {
      animation: hero-reel-in var(--reveal-duration) var(--reveal-ease) 0.45s
        both;
    }

    @keyframes hero-reel-in {
      from {
        opacity: 0;
        translate: 0 var(--reveal-distance);
      }
    }
  }
</style>
