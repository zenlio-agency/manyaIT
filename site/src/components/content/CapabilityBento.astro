---
import SectionHeader from "@/components/content/SectionHeader.astro";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import PhotoTile from "@/components/item/PhotoTile.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import capTalent from "@/assets/icons/cap-talent.svg";
import { capabilityHref } from "@/data/site.ts";
import { capabilities, home } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const [CAPABILITIES, { sections }] = await Promise.all([
  capabilities(),
  home(),
]);
const intro = sections.capabilities;
---

{
  render && (
    <div class="bento_wrap">
      <SectionHeader
        eyebrow={intro.eyebrow}
        heading={intro.heading}
        intro={intro.intro}
      >
        <Button
          slot="action"
          element="link"
          href="/capabilities"
          emphasis="secondary"
        >
          All Capabilities
        </Button>
      </SectionHeader>

      <div class="bento_grid">
        {CAPABILITIES.map((cap, index) => (
          <PhotoTile
            href={capabilityHref(cap)}
            photo={cap.photo?.src}
            photoPosition={cap.photo?.position}
            class={`bento_tile is-${cap.id}`}
            id={cap.id}
            data-reveal
            style={`--reveal-order: ${index % 3}`}
          >
            <span class="photo-tile_icon" slot="top">
              <Icon src={cap.icon} variant="small" />
            </span>
            <h3 class:list={["photo-tile_title", index === 0 && "is-large"]}>
              {cap.title}
            </h3>
            <Fragment slot="reveal">
              <p class="photo-tile_text">{cap.line}</p>
              <span class="photo-tile_more">
                Explore
                <Icon src={arrow} variant="small" />
              </span>
            </Fragment>
          </PhotoTile>
        ))}

        <PhotoTile
          href="/capabilities/specialist-talent"
          photo="/images/specialist-talent-hero.jpg"
          class="bento_tile is-cap-talent"
          id="cap-talent"
          data-reveal
          style="--reveal-order: 2"
        >
          <span class="photo-tile_icon" slot="top">
            <Icon src={capTalent} variant="small" />
          </span>
          <h3 class="photo-tile_title">
            Specialist Talent
          </h3>
          <Fragment slot="reveal">
            <p class="photo-tile_text">
              The right specialists, engaged the way your business needs them, across the U.S. and India.
            </p>
            <span class="photo-tile_more">
              Explore
              <Icon src={arrow} variant="small" />
            </span>
          </Fragment>
        </PhotoTile>
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.bento_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .bento_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    /* Photo mosaic: Data leads as a large square, the rest fill around it. */
    .bento_grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: 17rem;
      gap: var(--site-gutter);
      @media (width >= 48rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: 15rem;
        grid-template-areas:
          "data data"
          "sap ai"
          "flow code"
          "talent talent";
      }
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        grid-template-areas:
          "data data sap sap"
          "data data ai flow"
          "code code talent talent";
      }
      /* Areas only exist from 48rem; on phones the tiles simply stack. */
      @media (width >= 48rem) {
        & > .is-cap-data {
          grid-area: data;
        }
        & > .is-cap-sap {
          grid-area: sap;
        }
        & > .is-cap-ai {
          grid-area: ai;
        }
        & > .is-cap-flow {
          grid-area: flow;
        }
        & > .is-cap-code {
          grid-area: code;
        }
        & > .is-cap-talent {
          grid-area: talent;
        }
      }
    }

    .bento_tile {
      min-height: 0;
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    /* The two single-column tiles are too short for the icon, the title
       and the one-liner together, so the icon steps aside while the
       one-liner shows (always, on touch screens). */
    @media (width >= 64rem) {
      .bento_tile:is(.is-cap-ai, .is-cap-flow) {
        &:is(:hover, :focus-visible, :focus-within) .photo-tile_icon {
          display: none;
        }
        @media (hover: none) {
          & .photo-tile_icon {
            display: none;
          }
        }
      }
    }
  }
</style>
