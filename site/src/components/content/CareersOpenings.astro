---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Icon from "@/components/media/Icon.astro";
import arrowUp from "@/assets/icons/ui-arrow-up-right.svg";
import PhotoTile from "@/components/item/PhotoTile.astro";
import { tbc } from "@/data/site.ts";
import { LEGAL, mailLink } from "@/data/legal.ts";
import { CAREERS_POINT_PHOTOS } from "@/data/photos.ts";
import { applyHref } from "@/data/careers.ts";
import { capabilities, page, roles } from "@/sanity/content.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
}

const { render = true } = Astro.props;

const [CAPABILITIES, ROLES, { hero }] = await Promise.all([
  capabilities(),
  roles(),
  page("page-careers"),
]);

const points = [
  {
    title: "Enterprise-scale impact",
    text: "Platforms in banking, telecommunications, healthcare, energy and retail that serve customers at enterprise scale.",
  },
  {
    title: "End-to-end ownership",
    text: "Take work from architecture to production, and see the business results it creates.",
  },
  {
    title: "Learning & growth",
    text: "Certifications across SAP, cloud and AI platforms, with leads and architects promoted from within.",
  },
  {
    title: "Global by design",
    text: "One delivery organization across time zones, working directly with the leaders who own each outcome.",
  },
];

const teams = [...CAPABILITIES.map((cap) => cap.title), "Client Partnership"];
---

{
  render && (
    <div class="careers_wrap">
      <div class="careers_top">
        <div class="careers_intro">
          <Eyebrow data-reveal>{hero.eyebrow}</Eyebrow>
          <Heading tag="h1" variant="h1" data-reveal style="--reveal-order: 1">
            {hero.title}
          </Heading>
          <Paragraph
            variant="large"
            maxWidth={48}
            data-reveal
            style="--reveal-order: 2"
          >
            {hero.lede}
          </Paragraph>
          <Paragraph maxWidth={52} data-reveal style="--reveal-order: 3">
            <Fragment
              set:html={tbc(
                "Every new team member receives a growth plan within their first 90 days, with certifications to pursue, a mentor to learn from and a role to grow into.",
              )}
            />
          </Paragraph>
        </div>
        <ul class="careers_points">
          {points.map((point, index) => (
            <li data-reveal style={`--reveal-order: ${index}`}>
              <PhotoTile
                photo={CAREERS_POINT_PHOTOS[index]}
                class="careers_points_tile"
              >
                <span class="photo-tile_eyebrow" slot="top">
                  0{index + 1}
                </span>
                <h3 class="photo-tile_title is-small">{point.title}</h3>
                <p class="photo-tile_text" slot="reveal">
                  {point.text}
                </p>
              </PhotoTile>
            </li>
          ))}
        </ul>
      </div>

      <div class="careers_finder" id="roles" data-roles data-reveal>
        <div class="careers_finder_head">
          <Heading tag="h3" variant="h4">
            Find your role
          </Heading>
          <span class="careers_finder_note">
            Sample openings · live roles connect at launch
          </span>
        </div>
        <form class="careers_filters" role="search" aria-label="Find your role">
          <label class="careers_field is-search">
            <span class="sr-only">Role or skill</span>
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <>
                <circle cx="11" cy="11" r="6.5" />
                <path d="m16 16 4 4" />
              </>
            </svg>
            <input
              type="search"
              name="q"
              placeholder="Role or skill, e.g. Data engineer"
              autocomplete="off"
            />
          </label>
          <label class="careers_field">
            <span class="sr-only">Location</span>
            <select name="location">
              <option value="">All locations</option>
              <option>United States</option>
              <option>India</option>
              <option>Remote</option>
            </select>
          </label>
          <label class="careers_field">
            <span class="sr-only">Team</span>
            <select name="team">
              <option value="">All teams</option>
              {teams.map((team) => (
                <option>{team}</option>
              ))}
            </select>
          </label>
        </form>
        <ul class="careers_roles" aria-live="polite">
          {ROLES.map((role) => (
            <li
              class="careers_role"
              data-text={`${role.title} ${role.team} ${role.location}`.toLowerCase()}
              data-country={role.country}
              data-mode={role.mode}
              data-team={role.team}
            >
              <a class="careers_role_link" href={applyHref(role.slug)}>
                <span class="careers_role_main">
                  <span class="careers_role_title">{role.title}</span>
                  <span class="careers_role_team">{role.team}</span>
                </span>
                <span class="careers_role_meta">
                  <span>{role.location}</span>
                  <span>{role.experience}</span>
                  <span>{role.mode}</span>
                </span>
                <span class="careers_role_go">
                  <span class="careers_role_go_label">Apply</span>
                  <Icon src={arrowUp} variant="small" />
                </span>
              </a>
            </li>
          ))}
        </ul>
        <p class="careers_empty" hidden={ROLES.length > 0}>
          No open roles match your filters right now. Register your interest and
          our people team will reach out when a relevant role opens.
        </p>
        <p
          class="careers_trust text-style-small"
          set:html={tbc(
            `ManyaIT never charges a fee at any stage. Report any payment request to ${mailLink(LEGAL.careersEmail)}, and see <a href="/legal/job-offer-fraud">how to spot a fake offer</a>. Our <a href="/legal/applicant-privacy">Applicant Privacy Notice</a> explains how we handle your details.`,
          )}
        />
      </div>
    </div>
  )
}

<script>
  for (const finder of document.querySelectorAll<HTMLElement>("[data-roles]")) {
    const form = finder.querySelector<HTMLFormElement>("form");
    const roles = [...finder.querySelectorAll<HTMLElement>(".careers_role")];
    const empty = finder.querySelector<HTMLElement>(".careers_empty");
    if (!form) continue;

    const filter = () => {
      const data = new FormData(form);
      const query = String(data.get("q") ?? "")
        .trim()
        .toLowerCase();
      const location = String(data.get("location") ?? "");
      const team = String(data.get("team") ?? "");
      let shown = 0;
      for (const role of roles) {
        const match =
          (!query || (role.dataset.text ?? "").includes(query)) &&
          (!location ||
            role.dataset.country === location ||
            (location === "Remote" && role.dataset.mode === "Remote")) &&
          (!team || role.dataset.team === team);
        role.hidden = !match;
        if (match) shown++;
      }
      if (empty) empty.hidden = shown > 0;
    };

    form.addEventListener("input", filter);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      filter();
    });
  }
</script>

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.careers_wrap) :where(.heading, .text) {
      margin-block: 0;
    }
    .careers_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }

    .careers_top {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-8) var(--section-space-small);
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
        align-items: end;
      }
    }

    .careers_intro {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .careers_points {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--site-gutter);
      @media (width >= 30rem) {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }
    }

    .careers_points_tile {
      height: 100%;
      min-height: 14rem;
    }

    .careers_finder {
      display: flex;
      flex-direction: column;
      gap: var(--space-5);
      padding: var(--space-6);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      border: var(--border-width) solid var(--border);
      scroll-margin-top: calc(var(--nav-height) + var(--space-5));
    }

    .careers_finder_head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-2) var(--space-5);
    }

    .careers_finder_note {
      font-size: var(--text-small);
      color: var(--text-2);
    }

    .careers_filters {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-2);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
      }
    }

    .careers_field {
      position: relative;
      display: flex;
      align-items: center;
      & input,
      & select {
        width: 100%;
        min-height: 3rem;
        padding: 0 1rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-small);
        background-color: var(--background);
        color: var(--text);
        transition: border-color var(--hover-duration) var(--hover-ease);
        &::placeholder {
          color: var(--slate-400);
        }
        &:focus-visible {
          outline: none;
          border-color: var(--accent);
          box-shadow: 0 0 0 0.2rem var(--accent-soft);
        }
      }
      &.is-search input {
        padding-left: 2.75rem;
      }
      & svg {
        position: absolute;
        left: 1rem;
        width: 1.1rem;
        fill: none;
        stroke: var(--text-2);
        stroke-width: 1.8;
        stroke-linecap: round;
        pointer-events: none;
      }
    }

    .careers_roles {
      display: flex;
      flex-direction: column;
      border-top: var(--border-width) solid var(--divider);
      max-height: 28rem;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding-right: var(--space-2);
      scrollbar-width: thin;
      scrollbar-color: var(--border) transparent;
      &::-webkit-scrollbar {
        width: 6px;
      }
      &::-webkit-scrollbar-track {
        background: transparent;
      }
      &::-webkit-scrollbar-thumb {
        background-color: var(--border);
        border-radius: var(--radius-round);
      }
      &::-webkit-scrollbar-thumb:hover {
        background-color: var(--accent);
      }
    }

    .careers_role {
      border-bottom: var(--border-width) solid var(--divider);
      &[hidden] {
        display: none;
      }
    }

    .careers_role_link {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: var(--space-2) var(--space-5);
      padding: var(--space-4) var(--space-2);
      border-radius: var(--radius-small);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        padding var(--hover-duration) var(--hover-ease);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 1fr) auto auto;
      }
      @media (hover: hover) {
        &:hover {
          background-color: var(--background-3);
          padding-inline: var(--space-4);
          .careers_role_go {
            background-color: var(--accent);
            border-color: var(--accent);
            color: var(--white);
          }
        }
      }
    }

    .careers_role_main {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .careers_role_title {
      font-family: var(--heading-family);
      font-weight: var(--heading-bold);
      color: var(--text);
    }

    .careers_role_team {
      font-size: var(--text-small);
      color: var(--text-2);
    }

    .careers_role_meta {
      display: none;
      gap: var(--space-2);
      font-size: 0.78rem;
      @media (width >= 48rem) {
        display: flex;
      }
      & span {
        padding: 0.25rem 0.65rem;
        border-radius: var(--radius-round);
        background-color: var(--background-3);
        color: var(--text-body);
      }
    }

    /* A round arrow on small screens; "Apply" joins it from tablet up. */
    .careers_role_go {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.4rem;
      min-width: 2.5rem;
      height: 2.5rem;
      border-radius: var(--radius-round);
      font-size: var(--text-small);
      font-weight: var(--primary-medium);
      @media (width >= 48rem) {
        padding-inline: 1rem 0.85rem;
      }
      border: var(--border-width) solid var(--border);
      color: var(--text);
      transition:
        background-color var(--hover-duration) var(--hover-ease),
        border-color var(--hover-duration) var(--hover-ease),
        color var(--hover-duration) var(--hover-ease);
    }

    .careers_role_go_label {
      @media (width < 48rem) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    .careers_empty {
      padding: var(--space-5);
      border-radius: var(--radius-small);
      background-color: var(--background-3);
      color: var(--text-body);
      &[hidden] {
        display: none;
      }
    }

    .careers_trust {
      color: var(--text-2);
      & a {
        color: var(--link-text);
        text-decoration: underline;
        text-underline-offset: 0.2em;
      }
    }
  }
</style>
