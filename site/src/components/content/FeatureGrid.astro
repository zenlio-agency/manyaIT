---
import SectionHeader from "@/components/content/SectionHeader.astro";
import type { SvgComponent } from "astro/types";
import Button from "@/components/Button.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/ui-arrow.svg";
import { tbc } from "@/data/site.ts";

type Item = {
  title: string;
  text: string;
  href?: string;
  icon?: SvgComponent;
  list?: string[];
};

type Common = {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pill label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Paragraph beside the heading. */
  intro?: string;
  /** Button beside the heading. */
  link?: { label: string; href: string };
  /** Cards or rows. An item with `href` links the whole card or row. */
  items?: Item[];
  /** Number each item 01, 02, 03. */
  numbered?: boolean;
  /** Link text on items with `href`. */
  linkLabel?: string;
};

type Props = Common &
  (
    | {
        /** Layout. */
        variant?: "cards";
        /** Cards per row on wide screens. */
        columns?: 2 | 3 | 4;
      }
    | {
        variant: "rows";
        columns?: never;
      }
  );

type AllProps = Common & { variant?: "cards" | "rows"; columns?: 2 | 3 | 4 };

const {
  render = true,
  eyebrow,
  heading,
  intro,
  link,
  items = [],
  numbered = false,
  linkLabel = "Learn more",
  variant = "cards",
  columns = 3,
}: AllProps = Astro.props;
---

{
  render && items.length > 0 && (
    <div class:list={["feature-grid_wrap", `is-${variant}`]}>
      {heading && (
        <SectionHeader eyebrow={eyebrow} heading={heading} intro={intro}>
          {link && (
            <Button
              slot="action"
              element="link"
              href={link.href}
              emphasis="secondary"
            >
              {link.label}
            </Button>
          )}
        </SectionHeader>
      )}
      <ul class="feature-grid_list" style={`--_columns: ${columns}`}>
        {items.map((item, index) => (
          <li
            class:list={["feature-grid_item", item.href && "is-linked"]}
            data-reveal
            style={`--reveal-order: ${index % columns}`}
          >
            {item.icon ? (
              <span class="feature-grid_icon">
                <Icon src={item.icon} variant="small" />
              </span>
            ) : (
              numbered && (
                <span class="feature-grid_number">
                  {String(index + 1).padStart(2, "0")}
                </span>
              )
            )}
            <h3 class="feature-grid_title">
              {item.href ? <a href={item.href}>{item.title}</a> : item.title}
            </h3>
            <p class="feature-grid_text" set:html={tbc(item.text)} />
            {item.list && (
              <ul class="feature-grid_points">
                {item.list.map((point) => (
                  <li>{point}</li>
                ))}
              </ul>
            )}
            {item.href && (
              <span class="feature-grid_more" aria-hidden="true">
                <span>{linkLabel}</span>
                <Icon src={arrow} variant="small" />
              </span>
            )}
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.feature-grid_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .feature-grid_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-7);
    }

    .feature-grid_intro,
    .feature-grid_item {
      position: relative;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-3);
      min-width: 0;
    }

    /* The title link stretches over its card or row. */
    .feature-grid_title {
      font-family: var(--display-family);
      font-size: var(--h5);
      font-weight: var(--heading-bold);
      line-height: 1.25;
      letter-spacing: var(--letter-spacing-snug);
      text-wrap: balance;
      color: var(--text);
      & a {
        color: inherit;
        text-decoration: none;
        &::after {
          content: "";
          position: absolute;
          inset: 0;
          border-radius: inherit;
        }
        &:focus-visible {
          outline: none;
          &::after {
            outline: var(--focus-width) solid var(--focus-ring);
            outline-offset: var(--focus-offset);
          }
        }
      }
    }

    .feature-grid_text {
      font-size: var(--text-small);
      line-height: 1.6;
      color: var(--text-body);
    }

    .feature-grid_number {
      font-family: var(--display-family);
      font-size: var(--text-small);
      font-weight: 700;
      letter-spacing: var(--letter-spacing-wide);
      color: var(--accent);
      line-height: 1.4;
      overflow-wrap: break-word;
    }

    .feature-grid_icon {
      display: grid;
      place-items: center;
      width: 2.75rem;
      height: 2.75rem;
      flex: none;
      border-radius: var(--radius-medium);
      background-color: var(--accent-soft);
      color: var(--accent-text);
    }

    .feature-grid_points {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: var(--text-small);
      color: var(--text-body);
      & li {
        display: flex;
        gap: 0.6rem;
        &::before {
          content: "";
          flex: none;
          width: 0.4rem;
          height: 0.4rem;
          margin-top: 0.55em;
          border-radius: 50%;
          background-color: var(--accent);
        }
      }
    }

    .feature-grid_more {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      margin-top: auto;
      padding-top: var(--space-1);
      font-family: var(--heading-family);
      font-size: var(--text-small);
      font-weight: var(--heading-medium);
      color: var(--accent-text);
      & .icon {
        transition: translate var(--hover-duration) var(--hover-ease);
      }
    }

    /* Cards */
    .feature-grid_wrap.is-cards {
      .feature-grid_list {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: var(--site-gutter);
        @media (width >= 48rem) {
          grid-template-columns: repeat(2, minmax(0, 1fr));
        }
        @media (width >= 64rem) {
          grid-template-columns: repeat(3, minmax(0, 1fr));
          grid-template-columns: repeat(var(--_columns, 3), minmax(0, 1fr));
        }
      }
      .feature-grid_title {
        font-size: clamp(1.25rem, 1.1rem + 0.5vw, 1.625rem);
        overflow-wrap: anywhere;
        min-height: 2.5em;
      }
      .feature-grid_item {
        min-width: 0;
        height: 100%;
        padding: var(--space-6);
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-main);
        background-color: var(--background-2);
        /* Lists the scroll-reveal fade too: setting transition here
           replaces the base [data-reveal] one. */
        transition:
          border-color var(--hover-duration) var(--hover-ease),
          opacity var(--reveal-duration) var(--reveal-ease)
            calc(var(--reveal-order, 0) * 90ms),
          translate var(--reveal-duration) var(--reveal-ease)
            calc(var(--reveal-order, 0) * 90ms);
        &.is-linked {
          @media (hover: hover) {
            &:hover {
              border-color: var(--accent);
              .feature-grid_more .icon {
                translate: 0.2rem 0;
              }
            }
          }
        }
      }
    }

    /* Rows */
    .feature-grid_wrap.is-rows {
      .feature-grid_list {
        display: flex;
        flex-direction: column;
        border-top: var(--border-width) solid var(--border);
      }
      .feature-grid_item {
        display: grid;
        grid-template-columns: auto minmax(0, 1fr);
        align-items: center;
        gap: var(--space-2) var(--space-5);
        padding: var(--space-5) var(--space-2);
        border-bottom: var(--border-width) solid var(--border);
        border-radius: var(--radius-small);
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          padding var(--hover-duration) var(--hover-ease),
          opacity var(--reveal-duration) var(--reveal-ease)
            calc(var(--reveal-order, 0) * 90ms),
          translate var(--reveal-duration) var(--reveal-ease)
            calc(var(--reveal-order, 0) * 90ms);
        @media (width >= 48rem) {
          grid-template-columns: auto minmax(0, 4fr) minmax(0, 6fr) auto;
        }
        & > :not(.feature-grid_icon, .feature-grid_number) {
          grid-column: 2;
          @media (width >= 48rem) {
            grid-column: auto;
          }
        }
        /* A row with a list: the list sits under the text, in its column,
           and the title and arrow span both. */
        &:has(> .feature-grid_points) {
          @media (width >= 48rem) {
            align-items: start;
            &
              > :is(
                .feature-grid_icon,
                .feature-grid_number,
                .feature-grid_title
              ) {
              grid-row: 1 / span 2;
            }
            & > .feature-grid_text {
              grid-area: 1 / 3;
            }
            & > .feature-grid_points {
              grid-area: 2 / 3;
            }
            & > .feature-grid_more {
              grid-area: 1 / 4 / span 2;
              align-self: center;
            }
          }
        }
        &.is-linked {
          @media (hover: hover) {
            &:hover {
              padding-inline: var(--space-4);
              background-color: var(--background-2);
              .feature-grid_more {
                background-color: var(--accent);
                border-color: var(--accent);
                color: var(--white);
              }
            }
          }
        }
      }
      .feature-grid_number {
        min-width: 2.75rem;
      }
      /* In a row the link shrinks to a round arrow button. */
      .feature-grid_more {
        display: none;
        place-items: center;
        width: 2.5rem;
        height: 2.5rem;
        margin: 0;
        padding: 0;
        border: var(--border-width) solid var(--border);
        border-radius: 50%;
        color: var(--text);
        transition:
          background-color var(--hover-duration) var(--hover-ease),
          border-color var(--hover-duration) var(--hover-ease),
          color var(--hover-duration) var(--hover-ease);
        @media (width >= 48rem) {
          display: grid;
        }
        & span {
          display: none;
        }
      }
    }
  }
</style>
