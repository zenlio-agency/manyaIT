---
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import { slotContent } from "@/utils/slots.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** The page's H1, also the last breadcrumb. */
  title: string;
  /** Paragraph under the title. */
  lede?: string;
}

const { render = true, title, lede } = Astro.props;
/* The meta slot holds the dates, version and print button. */
const meta = await slotContent(Astro.slots, "meta");
---

{
  render && (
    <header class="legal-header_wrap">
      <nav class="legal-header_crumbs" aria-label="Breadcrumb">
        <ol>
          <li>
            <a href="/">Home</a>
          </li>
          <li>
            <a href="/legal">Legal</a>
          </li>
          <li>
            <span aria-current="page">{title}</span>
          </li>
        </ol>
      </nav>
      <Heading tag="h1" variant="h2">
        {title}
      </Heading>
      {lede && (
        <Paragraph variant="large" maxWidth={52}>
          {lede}
        </Paragraph>
      )}
      {meta && <div class="legal-header_meta" set:html={meta} />}
    </header>
  )
}

<style is:global>
  @layer components {
    .legal-header_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding-bottom: var(--space-6);
      border-bottom: var(--border-width) solid var(--border);
      & :is(.heading, .text) {
        margin-block: 0;
      }
    }

    .legal-header_crumbs ol {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.25rem 0.5rem;
      font-size: var(--text-small);
      color: var(--text-2);
      & li + li::before {
        content: "/";
        margin-right: 0.5rem;
        color: var(--slate-300);
      }
      & a {
        color: var(--text-2);
        text-decoration: none;
        transition: color var(--hover-duration) var(--hover-ease);
        @media (hover: hover) {
          &:hover {
            color: var(--accent-text);
          }
        }
      }
      & [aria-current] {
        color: var(--text);
      }
    }

    .legal-header_meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-3) var(--space-5);
      color: var(--text-2);
      & p {
        margin-block: 0;
      }
    }
  }
</style>
