---
import SectionHeader from "@/components/content/SectionHeader.astro";
import { tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pill label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Paragraph under the heading. */
  intro?: string;
  /** Each row pairs a challenge, in the reader's words, with the answer. */
  rows?: { challenge: string; answer: string }[];
  /** Label over each challenge. */
  challengeLabel?: string;
  /** Label over each answer. */
  answerLabel?: string;
}

const {
  render = true,
  eyebrow,
  heading,
  intro,
  rows = [],
  challengeLabel = "What we hear",
  answerLabel = "How the team answers",
} = Astro.props;
---

{
  render && heading && rows.length > 0 && (
    <div class="problem-rows_wrap">
      <SectionHeader
        class="problem-rows_head"
        layout="stack"
        eyebrow={eyebrow}
        heading={heading}
        intro={intro}
        introVariant="main"
      />
      <ol class="problem-rows_list">
        {rows.map((row, index) => (
          <li
            class="problem-rows_item"
            data-reveal
            style={`--reveal-order: ${index % 2}`}
          >
            <div class="problem-rows_side">
              <span class="problem-rows_label">{challengeLabel}</span>
              <h3 class="problem-rows_challenge">“{row.challenge}”</h3>
            </div>
            <span class="problem-rows_arrow" aria-hidden="true">
              <svg viewBox="0 0 24 24">
                <path d="M5 12h14m-5-5 5 5-5 5" />
              </svg>
            </span>
            <div class="problem-rows_side">
              <span class="problem-rows_label is-answer">{answerLabel}</span>
              <p class="problem-rows_answer" set:html={tbc(row.answer)} />
            </div>
          </li>
        ))}
      </ol>
    </div>
  )
}

<style is:global>
  @layer components {
    /* The header stays in view beside the long column on desktop. */
    .problem-rows_head {
      @media (width >= 64rem) {
        position: sticky;
        top: calc(var(--nav-height) + var(--space-5));
      }
    }

    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.problem-rows_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    /* The heading holds still on the left while the rows scroll past. */
    .problem-rows_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7) var(--section-space-small);
      align-items: start;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      }
    }

    .problem-rows_list {
      display: flex;
      flex-direction: column;
      gap: var(--space-3);
    }

    .problem-rows_item {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
      padding: var(--space-5);
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 5fr) auto minmax(0, 6fr);
        align-items: center;
        padding: var(--space-5) var(--space-6);
      }
    }

    .problem-rows_side {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
    }

    .problem-rows_label {
      font-family: var(--heading-family);
      font-size: 0.72rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--text-2);
      &.is-answer {
        color: var(--accent);
      }
    }

    .problem-rows_challenge {
      font-family: var(--display-family);
      font-size: var(--h5);
      font-weight: var(--heading-bold);
      line-height: 1.3;
      letter-spacing: var(--letter-spacing-snug);
      text-wrap: balance;
      color: var(--text);
    }

    .problem-rows_answer {
      font-size: var(--text-small);
      line-height: 1.6;
      color: var(--text-body);
    }

    .problem-rows_arrow {
      display: none;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      border-radius: 50%;
      background-color: var(--accent-soft);
      @media (width >= 48rem) {
        display: grid;
      }
      & svg {
        width: 1.1rem;
        fill: none;
        stroke: var(--accent-text);
        stroke-width: 1.8;
        stroke-linecap: round;
        stroke-linejoin: round;
      }
    }
  }
</style>
