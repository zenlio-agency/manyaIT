---
import type { HTMLAttributes } from "astro/types";
import SanityImg from "@/components/media/SanityImg.astro";
import Button from "@/components/Button.astro";
import { home } from "@/sanity/content.ts";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
};

const { render = true, class: className, ...rest } = Astro.props;

/* The photos and captions are edited in Sanity, on the homepage. */
const { reel: photos } = await home();
---

{
  render && (
    <div class:list={["reel_wrap", className]} {...rest} data-reel>
      <div class="reel_viewport">
        <div class="reel_track">
          {[0, 1].map((copy) => (
            <div
              class="reel_panel"
              aria-hidden={copy === 1 ? "true" : undefined}
              inert={copy === 1}
            >
              {photos.map((photo, index) => (
                <figure class="reel_tile" data-lift={index}>
                  <div class="reel_box">
                    <SanityImg
                      image={
                        copy === 0
                          ? photo.image
                          : { ...photo.image, alt: "", decorative: true }
                      }
                      variant="densities"
                      width={296}
                      height={216}
                      loading="eager"
                    />
                  </div>
                  <figcaption>{photo.caption}</figcaption>
                </figure>
              ))}
            </div>
          ))}
        </div>
      </div>
      <div class="reel_controls">
        <Button
          variant="play"
          emphasis="secondary"
          pressed={true}
          label="Pause"
          class="reel_toggle"
          data-reel-toggle
        />
      </div>
    </div>
  )
}

<script>
  for (const reel of document.querySelectorAll<HTMLElement>("[data-reel]")) {
    const toggle = reel.querySelector<HTMLButtonElement>("[data-reel-toggle]");
    const reduced = matchMedia("(prefers-reduced-motion: reduce)");
    const setPlaying = (playing: boolean) => {
      reel.dataset.state = playing ? "playing" : "paused";
      toggle?.setAttribute("aria-pressed", String(playing));
      toggle?.setAttribute("aria-label", playing ? "Pause" : "Play");
    };
    setPlaying(!reduced.matches);
    toggle?.addEventListener("click", () =>
      setPlaying(reel.dataset.state !== "playing"),
    );
    /* No visible button: a pointer pauses the reel by hovering, a tap or
       click stops or restarts it, and the keyboard reaches the toggle. */
    reel
      .querySelector(".reel_viewport")
      ?.addEventListener("click", () =>
        setPlaying(reel.dataset.state !== "playing"),
      );

    /* One photo at a time lifts out of the reel, walking through the
       tiles' data-lift keys. Still for reduced motion and hidden tabs. */
    const tiles = [...reel.querySelectorAll<HTMLElement>("[data-lift]")];
    const keys = [...new Set(tiles.map((tile) => tile.dataset.lift))];
    let index = 0;
    const show = (next: number) => {
      index = next;
      tiles.forEach((tile) =>
        tile.classList.toggle("is-active", tile.dataset.lift === keys[index]),
      );
    };
    if (keys.length) {
      show(0);
      window.setInterval(() => {
        if (reduced.matches || document.hidden) return;
        show((index + 1) % keys.length);
      }, 2600);
    }
  }
</script>

<style is:global>
  @layer components {
    .reel_wrap {
      --_gap: var(--space-4);
      width: 100vw;
      margin-inline: calc(50% - 50vw);
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
    }

    .reel_viewport {
      overflow: clip;
      padding-block: var(--space-2) var(--space-5);
      mask-image: linear-gradient(
        to right,
        transparent,
        black 6%,
        black 94%,
        transparent
      );
    }

    .reel_track {
      display: flex;
      width: max-content;
      gap: var(--_gap);
      animation: reel 70s linear infinite;
      animation-play-state: paused;
      .reel_wrap[data-state="playing"] & {
        animation-play-state: running;
      }
      .reel_wrap[data-state="playing"] &:is(:hover, :focus-within) {
        animation-play-state: paused;
      }
    }

    @keyframes reel {
      to {
        translate: calc(-50% - var(--_gap) / 2) 0;
      }
    }

    .reel_panel {
      display: flex;
      gap: var(--_gap);
    }

    .reel_tile {
      flex: none;
      width: 18.5rem;
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      & figcaption {
        padding-inline: 0.25rem;
        font-size: 0.8rem;
        color: var(--text-2);
      }
    }

    /* Photo card. The active one rings in blue and rises a little. */
    .reel_box {
      height: 13.5rem;
      border: var(--border-width) solid var(--border);
      border-radius: var(--radius-main);
      overflow: clip;
      background-color: var(--background-3);
      transition:
        border-color 500ms var(--hover-ease),
        box-shadow 500ms var(--hover-ease),
        translate 500ms var(--reveal-ease);
      .reel_tile.is-active > & {
        border-color: var(--accent);
        box-shadow: var(--shadow-float);
        translate: 0 -0.25rem;
      }
      & .image {
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
    }

    /* The toggle takes no space and shows only when the keyboard reaches
       it, over the reel's bottom edge. */
    .reel_wrap {
      position: relative;
    }

    .reel_controls {
      position: absolute;
      inset: auto 0 0;
      width: var(--site-width);
      max-width: var(--max-width-main);
      margin-inline: auto;
      display: flex;
      justify-content: flex-end;
      color: var(--text-2);
      pointer-events: none;
    }

    .reel_toggle {
      font-size: 0.75rem;
      pointer-events: auto;
      &:not(:focus-visible) {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .reel_viewport {
        overflow-x: auto;
      }
    }
  }
</style>
