---
import Eyebrow from "@/components/typography/Eyebrow.astro";
import { tbc } from "@/data/site.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pill label above the figures. */
  label?: string;
  /** Figures and what each one measures. */
  stats: { value: string; label: string }[];
}

const { render = true, label = "ManyaIT at a glance", stats } = Astro.props;
---

{
  render && stats.length > 0 && (
    <div class="trust-strip_wrap theme-dark" data-reveal>
      <Eyebrow>{label}</Eyebrow>
      <ul class="trust-strip_list">
        {stats.map((stat, index) => (
          <li
            class="trust-strip_item"
            data-reveal
            style={`--reveal-order: ${index + 1}`}
          >
            <span class="trust-strip_value" set:html={tbc(stat.value)} />
            <span class="trust-strip_label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style is:global>
  @layer components {
    /* A compact strip: tight padding and gaps so it reads as a summary
       under the statement, not a second hero. */
    .trust-strip_wrap {
      width: 100%;
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      padding: var(--space-4) var(--space-4) var(--space-5);
      border-radius: 1.5rem;
      overflow: clip;
      background-image: radial-gradient(
        circle at 100% 0%,
        color-mix(in srgb, var(--blue-500) 38%, transparent),
        transparent 55%
      );
      @media (width >= 64rem) {
        padding: var(--space-5) var(--space-6) var(--space-6);
      }
    }

    .trust-strip_list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-5) 0;
      @media (width >= 64rem) {
        grid-template-columns: repeat(4, minmax(0, 1fr));
      }
    }

    .trust-strip_item {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding-inline: var(--space-4) var(--space-2);
      border-left: var(--border-width) solid var(--border);
      @media (width >= 48rem) {
        padding-inline: var(--space-5);
      }
    }

    /* Figures scale with the viewport up to 3.25rem (52px). */
    .trust-strip_value {
      font-family: var(--display-family);
      font-size: clamp(1.75rem, 1rem + 2.2vw, 3.25rem);
      font-weight: 700;
      letter-spacing: var(--letter-spacing-tight);
      line-height: 1;
      color: var(--text);
      white-space: nowrap;
    }

    .trust-strip_label {
      max-width: 24ch;
      font-size: var(--text-small);
      line-height: 1.45;
      color: var(--text-body);
    }
  }
</style>
