---
import SectionHeader from "@/components/content/SectionHeader.astro";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Pill label above the heading. */
  eyebrow?: string;
  /** Section heading. */
  heading?: string;
  /** Paragraph under the heading. */
  intro?: string;
  /** Labelled rows of chips, such as roles, platforms or standards. */
  groups?: { title: string; items: string[] }[];
  /** A labelled line under the groups, such as the team behind the work. */
  note?: { label: string; text: string };
}

const {
  render = true,
  eyebrow,
  heading,
  intro,
  groups = [],
  note,
} = Astro.props;
---

{
  render && heading && groups.length > 0 && (
    <div class="chip-groups_wrap">
      <SectionHeader
        layout="stack"
        eyebrow={eyebrow}
        heading={heading}
        intro={intro}
        introVariant="main"
      />
      <div class="chip-groups_body">
        <dl class="chip-groups_list">
          {groups.map((group, index) => (
            <div
              class="chip-groups_row"
              data-reveal
              style={`--reveal-order: ${index}`}
            >
              <dt class="chip-groups_title">{group.title}</dt>
              <dd>
                <ul class="chip-groups_chips">
                  {group.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>
              </dd>
            </div>
          ))}
        </dl>
        {note && (
          <div class="chip-groups_note" data-reveal>
            <span class="chip-groups_note_label">{note.label}</span>
            <p class="chip-groups_note_text">{note.text}</p>
          </div>
        )}
      </div>
    </div>
  )
}

<style is:global>
  @layer components {
    /* Spacing here comes from gaps, so type margins step aside. */
    :where(.chip-groups_wrap) :where(.heading, .text) {
      margin-block: 0;
    }

    .chip-groups_wrap {
      width: 100%;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-7) var(--section-space-small);
      align-items: start;
      @media (width >= 64rem) {
        grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      }
    }

    .chip-groups_body {
      display: flex;
      flex-direction: column;
      gap: var(--space-6);
    }

    /* One line on the people behind the work, set apart from the chips. */
    .chip-groups_note {
      display: flex;
      flex-direction: column;
      gap: var(--space-2);
      padding: var(--space-5) var(--space-6);
      border: var(--border-width) solid var(--border);
      border-left: 3px solid var(--accent);
      border-radius: var(--radius-main);
      background-color: var(--background-2);
    }

    .chip-groups_note_label {
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--accent-text);
    }

    .chip-groups_note_text {
      margin: 0;
      font-family: var(--display-family);
      font-size: var(--h5);
      font-weight: var(--heading-medium);
      line-height: 1.4;
      color: var(--text);
    }

    .chip-groups_list {
      display: flex;
      flex-direction: column;
      border-top: var(--border-width) solid var(--border);
    }

    .chip-groups_row {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3) var(--space-6);
      padding-block: var(--space-5);
      border-bottom: var(--border-width) solid var(--border);
      @media (width >= 48rem) {
        grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      }
      & dd {
        margin: 0;
      }
    }

    .chip-groups_title {
      padding-top: 0.45rem;
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--accent);
    }

    .chip-groups_chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2);
      & li {
        padding: 0.45rem 0.9rem;
        border: var(--border-width) solid var(--border);
        border-radius: var(--radius-round);
        background-color: var(--background-2);
        font-size: var(--text-small);
        line-height: 1.3;
        color: var(--text);
      }
    }
  }
</style>
