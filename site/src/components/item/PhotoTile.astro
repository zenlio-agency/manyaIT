---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Link destination. Makes the whole tile a link. */
  href?: string;
  /** Link target, e.g. `_blank` for external sites. */
  target?: HTMLAttributes<"a">["target"];
  /** Link relationship, e.g. `noopener`. */
  rel?: string;
  /** Full-bleed background photo. */
  photo?: string;
  /** Photo alt text. Omit for decorative photos. */
  photoAlt?: string;
  /** The photo's intrinsic width and height, written as attributes. The
      tile's CSS sizes the photo either way. */
  photoWidth?: number;
  photoHeight?: number;
  /** The photo's focal point, as a CSS `object-position`. */
  photoPosition?: string;
  /** Ground when there is no photo. */
  tone?: "photo" | "brand" | "ink";
};

const {
  render = true,
  href,
  photo,
  photoAlt = "",
  photoWidth,
  photoHeight,
  photoPosition,
  tone = photo ? "photo" : "ink",
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? "a" : "div";
---

{
  render && (
    <Tag
      class:list={[
        "photo-tile",
        `is-${tone}`,
        tone === "brand" && "theme-brand",
        className,
      ]}
      href={href}
      {...rest}
    >
      {photo && (
        <img
          class="photo-tile_photo"
          src={photo}
          alt={photoAlt}
          width={photoWidth}
          height={photoHeight}
          style={photoPosition && `object-position: ${photoPosition}`}
          loading="lazy"
          decoding="async"
        />
      )}
      <div class="photo-tile_content">
        <slot name="top" />
        <slot />
        {Astro.slots.has("reveal") && (
          <div class="photo-tile_reveal">
            <div>
              <slot name="reveal" />
            </div>
          </div>
        )}
      </div>
    </Tag>
  )
}

<style is:global>
  @layer components {
    /* Full-bleed photo tile. Hover rings the tile in blue and slides up the
       detail; the photo itself stays still. */
    .photo-tile {
      position: relative;
      isolation: isolate;
      display: flex;
      align-items: flex-end;
      min-height: 15rem;
      overflow: hidden;
      border-radius: 1.5rem;
      background-color: var(--ink-black);
      color: var(--white);
      outline: 0.125rem solid transparent;
      outline-offset: 0.1875rem;
      /* Lists the scroll-reveal fade too: setting transition here replaces
         the base [data-reveal] one, which would make tiles pop in. */
      transition:
        outline-color var(--hover-duration) var(--hover-ease),
        opacity var(--reveal-duration) var(--reveal-ease)
          calc(var(--reveal-order, 0) * 90ms),
        translate var(--reveal-duration) var(--reveal-ease)
          calc(var(--reveal-order, 0) * 90ms);
      @media (hover: hover) {
        &:hover {
          outline-color: var(--blue-500);
        }
      }
      &:focus-visible {
        outline-color: var(--blue-500);
      }
      &:is(:hover, :focus-visible, :focus-within) .photo-tile_reveal {
        grid-template-rows: 1fr;
        opacity: 1;
      }
    }

    .photo-tile_photo {
      position: absolute;
      inset: 0;
      z-index: -2;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    /* Ink fades up from the bottom so white type always reads. */
    .photo-tile.is-photo::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: -1;
      background-image: linear-gradient(
        to top,
        rgb(13 15 13 / 0.9) 0%,
        rgb(13 15 13 / 0.5) 45%,
        rgb(13 15 13 / 0.08) 100%
      );
    }

    .photo-tile.is-ink {
      background-image:
        radial-gradient(
          circle at 100% 0%,
          color-mix(in srgb, var(--blue-500) 45%, transparent),
          transparent 60%
        ),
        radial-gradient(
          circle at 0% 100%,
          color-mix(in srgb, var(--blue-700) 30%, transparent),
          transparent 55%
        );
    }

    .photo-tile.is-brand {
      align-items: center;
      background-color: var(--background);
      background-image:
        radial-gradient(
          circle at 100% 0%,
          color-mix(in srgb, var(--white) 22%, transparent),
          transparent 55%
        ),
        radial-gradient(
          circle at 0% 100%,
          color-mix(in srgb, var(--ink-black) 35%, transparent),
          transparent 60%
        );
      color: var(--text);
    }

    .photo-tile_content {
      position: relative;
      width: 100%;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
      padding: var(--space-5);
    }

    .photo-tile_reveal {
      display: grid;
      grid-template-rows: 0fr;
      opacity: 0;
      transition:
        grid-template-rows 450ms var(--reveal-ease),
        opacity 350ms var(--hover-ease);
      & > div {
        min-height: 0;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        align-items: flex-start;
        gap: var(--space-2);
      }
      /* Touch screens can't hover, so the detail always shows. */
      @media (hover: none) {
        grid-template-rows: 1fr;
        opacity: 1;
      }
    }

    /* Shared pieces for tile content */
    .photo-tile_icon {
      display: grid;
      place-items: center;
      width: 2.5rem;
      height: 2.5rem;
      margin-bottom: var(--space-1);
      border-radius: var(--radius-medium);
      background-color: rgb(255 255 255 / 0.14);
      border: var(--border-width) solid rgb(255 255 255 / 0.22);
      -webkit-backdrop-filter: blur(0.5rem);
      backdrop-filter: blur(0.5rem);
    }

    .photo-tile_eyebrow {
      font-family: var(--heading-family);
      font-size: 0.75rem;
      font-weight: var(--heading-bold);
      letter-spacing: var(--letter-spacing-wide);
      text-transform: uppercase;
      color: var(--blue-200);
    }

    .photo-tile_title {
      font-family: var(--heading-family);
      font-size: var(--h5);
      font-weight: var(--heading-bold);
      line-height: 1.2;
      &.is-large {
        font-size: var(--h3);
      }
      &.is-small {
        font-size: var(--h6);
      }
    }

    .photo-tile_text {
      max-width: 42ch;
      font-size: var(--text-small);
      line-height: 1.55;
      color: rgb(255 255 255 / 0.82);
      .is-brand & {
        color: var(--text-body);
      }
    }

    .photo-tile_more {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      padding-top: var(--space-1);
      font-family: var(--heading-family);
      font-size: var(--text-small);
      font-weight: var(--heading-medium);
    }
  }
</style>
