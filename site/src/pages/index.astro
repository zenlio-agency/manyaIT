---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroHome from "@/components/content/HeroHome.astro";
import ClientLogos from "@/components/content/ClientLogos.astro";
import WhyMetrics from "@/components/content/WhyMetrics.astro";
import CapabilityBento from "@/components/content/CapabilityBento.astro";
import IndustryCards from "@/components/content/IndustryCards.astro";
import InsightsGrid from "@/components/content/InsightsGrid.astro";
import EcosystemCards from "@/components/content/EcosystemCards.astro";
import ContactConversation from "@/components/content/ContactConversation.astro";
import { home } from "@/sanity/content.ts";

const { seo } = await home();
---

<Layout title={seo.title} description={seo.description}>
  {/* Hero */}
  <Section paddingTop="none" paddingBottom="small">
    <HeroHome />
  </Section>

  {/* Client logos */}
  <Section paddingTop="small">
    <ClientLogos />
  </Section>

  {/* Capabilities */}
  <Section theme="tint" id="capabilities">
    <CapabilityBento />
  </Section>

  {/* Industries */}
  <Section id="industries">
    <IndustryCards />
  </Section>

  {/* Why ManyaIT: the figures, on a dark panel, with the way to careers */}
  <Section theme="tint" id="why">
    <WhyMetrics />
  </Section>

  {/* Insights */}
  <Section id="insights">
    <InsightsGrid />
  </Section>

  {/* Other companies */}
  <Section theme="tint" id="ecosystem" paddingTop="small" paddingBottom="small">
    <EcosystemCards />
  </Section>

  {/* Contact form, closing the page above the footer */}
  <Section id="contact">
    <ContactConversation headingTag="h2" variant="home" />
  </Section>
</Layout>
