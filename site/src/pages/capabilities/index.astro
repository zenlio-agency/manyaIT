---
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroDetail from "@/components/content/HeroDetail.astro";
import FeatureGrid from "@/components/content/FeatureGrid.astro";
import TeamPanel from "@/components/content/TeamPanel.astro";
import FaqList from "@/components/content/FaqList.astro";
import CtaFinal from "@/components/content/CtaFinal.astro";
import { capabilityHref } from "@/data/site.ts";
import capTalent from "@/assets/icons/cap-talent.svg";
import { capabilities, page, settings } from "@/sanity/content.ts";

const [CAPABILITIES, { hero, faqIntro, faq, seo }, { cta: CTA }] =
  await Promise.all([capabilities(), page("page-capabilities"), settings()]);
---

<Layout title={seo.title} description={seo.description}>
  {/* Hero */}
  <Section paddingTop="small">
    <HeroDetail
      crumbs={[{ label: "Home", href: "/" }, { label: "Capabilities" }]}
      eyebrow={hero.eyebrow}
      title={hero.title}
      lede={hero.lede}
      points={hero.points}
      primary={{ label: "Discuss your initiative", href: CTA.primary.href }}
      secondary={{ label: "Why ManyaIT", href: "/about" }}
      photo={hero.photo?.src}
      photoAlt={hero.photo?.alt}
      photoPosition={hero.photo?.position}
    />
  </Section>

  {/* The capabilities, each with its focus areas */}
  <Section theme="tint">
    <FeatureGrid
      variant="rows"
      eyebrow="What we deliver"
      heading="Integrated capabilities for data-driven, AI-ready enterprises"
      intro="Start with one capability or combine them into a single program. Data fuels AI, enterprise platforms anchor data, and digital products put it in front of customers. One partner carries the work across every layer."
      items={[
        ...CAPABILITIES.map((cap) => ({
          title: cap.title,
          text: cap.line,
          list: [...cap.focus],
          href: capabilityHref(cap),
          icon: cap.icon,
        })),
        {
          title: "Specialist Talent",
          text: "The right specialists, engaged the way your business needs them, across the U.S. and India.",
          list: [
            "Specialist technology talent",
            "Flexible engagement models",
            "Cross-border U.S. & India reach",
            "Permanent, contract & team options",
          ],
          href: "/capabilities/specialist-talent",
          icon: capTalent,
        },
      ]}
      linkLabel="Explore"
    />
  </Section>

  {/* Operating models */}
  <Section>
    <FeatureGrid
      eyebrow="Operating models"
      heading="Work with us the way your organization runs."
      intro="Every enterprise moves differently. Choose the model that fits your objectives today, and change it as priorities evolve."
      columns={4}
      numbered
      items={[
        {
          title: "Strategy & readiness assessment",
          text: "A time-boxed assessment of your architecture, data and AI readiness, ending in a prioritized roadmap and business cases leadership can fund.",
        },
        {
          title: "Outcome-based delivery",
          text: "We own a defined scope from discovery to deployment and hypercare, against agreed milestones, quality gates and service levels.",
        },
        {
          title: "Product & platform teams",
          text: "Persistent, cross-functional teams that own a product or platform roadmap, integrate with your engineering organization and scale with demand.",
        },
        {
          title: "Managed operations",
          text: "We run, monitor and optimize platforms in production under agreed service levels, and transfer operations and knowledge to your teams whenever you choose.",
        },
      ]}
    />
  </Section>

  {/* The team behind the work */}
  <Section theme="tint" id="team">
    <TeamPanel
      eyebrow="Team behind the work"
      heading="Senior talent, organized around outcomes."
      text="Every program is led by an accountable delivery lead and an architect, with engineers, data specialists and domain leads mobilized around your roadmap. The same team stays with the work, so knowledge compounds instead of resetting."
      points={[
        "Architects accountable for every program",
        "Specialists mobilized to the roadmap",
        "Continuity from first sprint to steady state",
      ]}
    />
  </Section>

  {/* FAQ */}
  <Section>
    <FaqList
      heading={faqIntro.heading || undefined}
      intro={faqIntro.intro || undefined}
      items={faq}
    />
  </Section>

  {/* Final CTA */}
  <Section theme="dark" paddingTop="large">
    <CtaFinal />
  </Section>
</Layout>
